    <!-- Policy comparison -->
    <string name="router_compare_title">Comparar políticas</string>
    <string name="router_compare_intro">Lanza un conjunto de prompts (simples, código, cálculo, datos personales, datos recientes, JSON, texto largo) bajo cada política con los motores utilizables ahora. Cada motor responde una sola vez a cada texto, así que las diferencias vienen de la ruta, no del azar. El coste es una estimación con el precio de Gemini Flash que usa Estadísticas.</string>
    <string name="router_compare_quick">Rápida (%1$d)</string>
    <string name="router_compare_full">Completa (%1$d)</string>
    <plurals name="router_compare_prompts">
