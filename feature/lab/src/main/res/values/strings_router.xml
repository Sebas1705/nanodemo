        <item quantity="other">%1$d prompts per policy</item>
    </plurals>
    <string name="router_compare_legend">“PII avoided”: personal data in the prompts that did not reach the cloud in clear (it stayed on the device or the filter masked it), compared with sending everything unfiltered. “Leaks”: those that did go out unmasked.</string>
