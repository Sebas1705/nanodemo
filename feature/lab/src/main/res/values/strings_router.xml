    <!-- Policies -->
    <string name="router_policy_section">Route policy</string>
    <string name="router_policy_local_first_label">Local first</string>
    <string name="router_policy_local_first_description">Tries the on-device engines and only moves up to the cloud if they are not enough.</string>
    <string name="router_policy_cloud_first_label">Cloud first</string>
    <string name="router_policy_cloud_first_description">Starts with the cloud; local engines are the backup.</string>
    <string name="router_policy_privacy_first_label">Privacy first</string>
    <string name="router_policy_privacy_first_description">Anything with personal data or marked as sensitive never leaves the device.</string>
    <string name="router_policy_cost_aware_label">Cost</string>
    <string name="router_policy_cost_aware_description">Local first, and the cloud only if the query fits the budget and is not trivial.</string>
    <string name="router_policy_latency_aware_label">Latency</string>
    <string name="router_policy_latency_aware_description">Sorts the engines by expected latency (or the one observed in this session).</string>
    <string name="router_policy_manual_label">Manual</string>
    <string name="router_policy_manual_description">A single engine picked by hand, with no escalation.</string>

