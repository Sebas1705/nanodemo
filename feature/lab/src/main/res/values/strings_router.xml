    <!-- Policy comparison -->
    <string name="router_compare_title">Compare policies</string>
    <string name="router_compare_intro">Runs a set of prompts (simple, code, calculation, personal data, recent data, JSON, long text) under each policy with the engines usable right now. Each engine answers each text only once, so the differences come from the route, not from chance. The cost is an estimate with the Gemini Flash price that Stats uses.</string>
