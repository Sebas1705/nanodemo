    <string name="router_option_gateway_title">Filter personal data before the cloud</string>
    <string name="router_option_gateway_hint">Emails, phones, IBANs, cards, DNI/NIE, IPs, URLs with keys and API keys are replaced with placeholders and restored here.</string>
    <string name="router_option_sensitive_title">Mark the prompt as sensitive</string>
    <string name="router_option_sensitive_hint">With “Privacy first” it will not leave the device even if no data is detected.</string>
    <string name="router_option_json_title">Expect JSON</string>
    <string name="router_option_json_hint">The cloud uses JSON mode; local engines get the instruction. An answer that is not valid JSON escalates.</string>
